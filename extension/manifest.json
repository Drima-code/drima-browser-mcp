{
  "manifest_version": 2,
  "name": "MCP Browser Bridge",
  "version": "0.1.1",
  "description": "Connect only explicitly approved job-search tabs to local MCP.",
  "browser_specific_settings": {
    "gecko": {
      "id": "approved-tabs@drima-browser.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity", "personallyIdentifyingInfo", "personalCommunications", "locationInfo"]
      }
    }
  },
  "permissions": ["activeTab", "nativeMessaging"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "MCP Browser Bridge: approve/revoke this job-search tab"}
}
